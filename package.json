{
  "name": "online-table-tennis",
  "version": "1.0.0",
  "private": true,
  "description": "3D Online Table Tennis Game with Singleplayer AI and Real-time Multiplayer",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm.cmd run build:client && npm.cmd run build:server",
    "test:game": "tsx tests/game.test.ts",
    "test:multiplayer": "tsx tests/multiplayer.test.ts",
    "test": "tsx tests/game.test.ts && tsx tests/multiplayer.test.ts",
    "start": "node dist/server/server/src/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
